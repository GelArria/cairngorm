{
  "name": "cairngorm",
  "private": true,
  "version": "0.4.2",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-document-sdk.mjs --check && tsc && vite build",
    "build:document-sdk": "node scripts/build-document-sdk.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c tests/playwright.config.ts",
    "test:e2e:headed": "playwright test --headed -c tests/playwright.config.ts",
    "test:e2e:reader": "e2e run tests/e2e/markdown-reader.e2e.ts",
    "tauri:setup": "node scripts/ensure-agent-config.mjs",
    "tauri:resetconfig": "node scripts/ensure-agent-config.mjs --reset",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,mjs,cjs,css}\" \"tests/**/*.{ts,tsx,js,mjs,cjs}\" \"scripts/**/*.{js,mjs,cjs}\" \"*.{ts,js,mjs,cjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,mjs,cjs,css}\" \"tests/**/*.{ts,tsx,js,mjs,cjs}\" \"scripts/**/*.{js,mjs,cjs}\" \"*.{ts,js,mjs,cjs}\"",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@fontsource/instrument-sans": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.0",
    "cloc": "^2.10.0-cloc",
    "clsx": "^2.1.0",
    "codemirror": "^6.0.2",
    "docx-preview": "^0.3.7",
    "dompurify": "^3.4.11",
    "jsonc-parser": "3.3.1",
    "lucide-preact": "^1.51.0",
    "marked": "^17.0.0",
    "openai": "^4.104.0",
    "preact": "^10.22.0",
    "tailwind-merge": "^2.2.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.14.0",
    "@playwright/test": "^1.59.1",
    "@preact/preset-vite": "^2.8.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^20.11.0",
    "autoprefixer": "^10.4.17",
    "cross-env": "^10.1.0",
    "e2e": "^0.20.0",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "postcss": "^8.4.33",
    "prettier": "3.8.3",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^4.1.5"
  }
}
